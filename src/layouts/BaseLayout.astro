---
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  /** Путь страницы с завершающим слэшем: "/", "/404/", "/<slug>/" */
  path: string;
  title: string;
  description?: string;
  /** Абсолютный или относительный URL картинки для соцсетей */
  ogImage?: string;
  /** Альт к ogImage; по умолчанию — общий из site.json */
  ogImageAlt?: string;
  /** "article" для текстовых страниц — у них в превью появляется дата */
  ogType?: 'website' | 'article';
  /** Дата публикации в ISO, только для ogType="article" */
  published?: string;
  isHome?: boolean;
  noindex?: boolean;
}

const {
  path,
  title,
  description = '',
  ogImage,
  ogImageAlt = site.meta.ogAlt,
  ogType = 'website',
  published,
  isHome = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;

// Полный заголовок: на главной — как есть, на внутренних — по шаблону из site.json.
const fullTitle = isHome ? title : site.meta.titleTemplate.replace('%s', title);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:site_name" content={site.sidebar.name} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && <meta property="article:author" content={site.sidebar.name} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Тема выставляется до первой отрисовки, иначе при тёмной теме мигает светлым */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        /* приватный режим — остаёмся на prefers-color-scheme */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#content">{site.ui.skipToContent}</a>

    <Sidebar />
    <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" aria-label={site.ui.closeMenu} hidden></button>

    <div class="shell">
      <Header isHome={isHome} />

      <main class="main" id="content">
        <slot />
        <Footer />
      </main>
    </div>

    <script>
      // --- Тема -------------------------------------------------------------
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-btn');

      themeBtn?.addEventListener('click', () => {
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* не критично */
        }
      });

      // --- Мобильное меню ---------------------------------------------------
      const sidebar = document.getElementById('sidebar');
      const menuBtn = document.getElementById('menu-btn');
      const backdrop = document.getElementById('sidebar-backdrop');

      function setMenu(open: boolean) {
        sidebar?.classList.toggle('is-open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        if (backdrop) backdrop.hidden = !open;
      }

      menuBtn?.addEventListener('click', () => setMenu(!sidebar?.classList.contains('is-open')));
      backdrop?.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
      sidebar?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });

      // --- Тень под шапкой при скролле --------------------------------------
      const header = document.querySelector('.header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // --- Подсветка активного раздела --------------------------------------
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav a[data-section]')];
      const anchored = navLinks.filter((a) => a.getAttribute('href')?.startsWith('#'));

      if (anchored.length > 0) {
        const sections = anchored
          .map((a) => document.getElementById(a.getAttribute('href')!.slice(1)))
          .filter((el): el is HTMLElement => el !== null);

        // Какие разделы сейчас в полосе наблюдения — состояние держим сами.
        // Сравнивать по intersectionRatio нельзя: он нормирован на высоту цели,
        // поэтому длинный раздел всегда проигрывает короткому соседу и мимо
        // низкого порога не проходит вовсе.
        const inBand = new Set<Element>();

        const atBottom = () =>
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

        const update = () => {
          // В конце страницы последний раздел до полосы уже не доезжает.
          let active = atBottom() ? sections[sections.length - 1] : undefined;

          // Иначе — последний по порядку документа, то есть тот, в который только что вошли.
          for (let i = sections.length - 1; !active && i >= 0; i--) {
            if (inBand.has(sections[i])) active = sections[i];
          }

          if (!active) return;
          navLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.section === active!.id));
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => (e.isIntersecting ? inBand.add(e.target) : inBand.delete(e.target)));
            update();
          },
          { rootMargin: '-25% 0px -60% 0px' }
        );

        sections.forEach((section) => observer.observe(section));
        window.addEventListener('scroll', update, { passive: true });
      }

      // --- Кнопки «скопировать» ---------------------------------------------
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const value = btn.dataset.copy ?? '';
          const done = btn.dataset.copiedLabel ?? 'OK';
          const idle = btn.textContent ?? '';
          try {
            await navigator.clipboard.writeText(value);
            btn.textContent = done;
            setTimeout(() => (btn.textContent = idle), 1600);
          } catch {
            /* нет доступа к буферу — оставляем как есть */
          }
        });
      });
    </script>
  </body>
</html>
