---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const email = site.contact.email.trim();
const links = site.contact.links.filter((l) => l.href.trim() !== '');
---

<section class="section" id="contact">
  <h2 class="section__title">{site.contact.heading}</h2>
  {site.contact.text && <p class="section__lead">{site.contact.text}</p>}

  {
    email && (
      <div class="mailbox">
        <Icon name="mail" />
        <a href={`mailto:${email}`}>{email}</a>
        <button type="button" data-copy={email} data-copied-label={site.contact.copied}>
          {site.contact.copy}
        </button>
      </div>
    )
  }

  {
    links.length > 0 && (
      <ul class="chips" style="margin-top:16px">
        {links.map((link) => (
          <li>
            <a class="chip chip--button" href={link.href} target="_blank" rel="noopener">
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
