---
import ProjectCard from '../ProjectCard.astro';
import site from '../../data/site.json';
import type { Project } from '../../lib/projects';

interface Props {
  projects: Project[];
  /** сколько карточек показать на главной */
  limit?: number;
}

const { projects, limit = 4 } = Astro.props;

// На главной показываем featured; если таких нет — просто первые по порядку.
const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length > 0 ? featured : projects).slice(0, limit);
const hasMore = projects.length > shown.length;
---

<section class="section" id="projects">
  <div class="section__head">
    <h2 class="section__title">{site.projects.heading}</h2>
    {
      (hasMore || shown.length > 0) && (
        <a class="link-more" href="/projects/">
          {site.projects.all} →
        </a>
      )
    }
  </div>

  {
    shown.length > 0 ? (
      <ul class="cards">
        {shown.map((project) => (
          <ProjectCard project={project} />
        ))}
      </ul>
    ) : (
      <p class="prose">{site.projects.empty}</p>
    )
  }
</section>
