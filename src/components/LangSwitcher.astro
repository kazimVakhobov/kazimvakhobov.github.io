---
import { langs, langLabels, languages, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Путь текущей страницы без языкового префикса, напр. "/projects/my-cli/" */
  path: string;
  label: string;
}

const { lang, path, label } = Astro.props;
---

<div class="lang" role="group" aria-label={label}>
  {
    langs.map((code) => (
      <a
        class="lang__btn"
        href={localizePath(path, code)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        title={languages[code]}
      >
        {langLabels[code]}
      </a>
    ))
  }
</div>
