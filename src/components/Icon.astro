---
/**
 * Инлайновые SVG-иконки, 24×24, рисуются обводкой currentColor.
 * Размер задаётся через CSS родителя (width/height), поэтому здесь атрибуты не фиксируем.
 */
interface Props {
  name: string;
  class?: string;
  /** декоративная (по умолчанию) или со своей подписью */
  label?: string;
}

const { name, class: className, label } = Astro.props;

const paths: Record<string, string> = {
  // интерфейс
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  moon: '<path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  arrowLeft: '<path d="M19 12H5M11 18l-6-6 6-6"/>',
  external: '<path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 01-1 1H6a1 1 0 01-1-1V7a1 1 0 011-1h4"/>',
  check: '<path d="M5 13l4 4L19 7"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 5H6a1 1 0 00-1 1v9"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5v-3a4 4 0 018 0v3"/>',
  branch: '<circle cx="7" cy="6" r="2.3"/><circle cx="7" cy="18" r="2.3"/><circle cx="17" cy="9" r="2.3"/><path d="M7 8.3v7.4M17 11.3c0 3.5-3.1 3.9-6 4.4"/>',

  // факты о себе
  pin: '<path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7.5l8.5 6 8.5-6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z"/>',
  briefcase: '<rect x="3" y="7.5" width="18" height="12.5" rx="2"/><path d="M8.5 7.5V5.5a2 2 0 012-2h3a2 2 0 012 2v2"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  languages: '<path d="M4 6h10M9 4v2c0 4-2 7-5 8M7 11c0 3 3 5 7 6M13 20l4-10 4 10M14.8 17h4.4"/>',

  // соцсети и ссылки
  github:
    '<path d="M9 19c-4 1.3-4-2.1-6-2.6m12 5v-3.6c0-1 .1-1.5-.5-2 2.3-.3 4.5-1.2 4.5-5.2a4 4 0 00-1.1-2.8 3.7 3.7 0 00-.1-2.8s-1.2-.4-3.8 1.4a9.4 9.4 0 00-5 0C6.4 3.8 5.2 4.2 5.2 4.2a3.7 3.7 0 00-.1 2.8A4 4 0 004 9.8c0 4 2.2 4.9 4.5 5.2-.6.5-.6 1-.5 2V21"/>',
  gitlab: '<path d="M12 21l-3.5-9.5h7L12 21zM12 21L3 11.5h5.5L12 21zM12 21l9-9.5h-5.5L12 21zM3 11.5L4.8 5l3.7 6.5H3zM21 11.5L19.2 5l-3.7 6.5H21z"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M7.5 10.5V17M7.5 7.3v.2M11.5 17v-3.8a2.3 2.3 0 014.6 0V17"/>',
  telegram: '<path d="M21 4.5L2.8 11.2l5.4 1.8 1.6 5.9 3-3.6 5.1 3.6z"/><path d="M8.2 13l9.6-7.4-6.6 9.3"/>',
  twitter: '<path d="M4 4l7 9-7 7h2l6-6 4.6 6H21l-7.4-9.6L20.5 4h-2l-5.4 5.5L9 4z"/>',
  npm: '<rect x="3" y="7" width="18" height="10" rx="1.5"/><path d="M7.5 17v-6h3v6M13.5 17v-6h3v4"/>',
  docs: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
  play: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5z"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 10l2.5 2L7 14M12.5 15h4"/>',
  star: '<path d="M12 4l2.4 5.1 5.6.7-4.1 3.9 1 5.6-4.9-2.8-4.9 2.8 1-5.6L4 9.8l5.6-.7z"/>',
  scale: '<path d="M12 4v16M6 8h12M6 8l-3 6h6zM18 8l-3 6h6z"/>',
  tag: '<path d="M11 4H5a1 1 0 00-1 1v6l9 9 8-8-9-9z"/><circle cx="8" cy="8" r="1.2"/>',
};

const path = paths[name] ?? paths.external;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={path}
/>
