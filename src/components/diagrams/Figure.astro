---
/**
 * Обёртка для схем: рамка, вынос за колонку текста (.bleed) и подпись.
 *
 * `scroll` — для схем с фиксированной внутренней шириной: под них ставим
 * горизонтальный скролл, а не сжимаем, иначе подписи на телефоне становятся
 * нечитаемыми. Справа у такой рамки появляется растушёвка — но только когда
 * справа действительно что-то осталось (класс вешает скрипт ниже).
 */
interface Props {
  label?: string;
  scroll?: boolean;
}

const { label, scroll = false } = Astro.props;
const hasCaption = Astro.slots.has('caption');
---

<figure class="fig bleed">
  {label && <p class="fig__label">{label}</p>}

  <div class:list={['fig__frame', { 'fig__frame--scroll': scroll }]}>
    {
      scroll ? (
        <div class="fig__scroller">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </div>

  {
    hasCaption && (
      <figcaption class="fig__cap">
        <slot name="caption" />
      </figcaption>
    )
  }
</figure>

<script>
  // Растушёвка у правого края — только пока есть куда прокручивать
  for (const frame of document.querySelectorAll<HTMLElement>('.fig__frame--scroll')) {
    const scroller = frame.querySelector<HTMLElement>('.fig__scroller');
    if (!scroller) continue;

    const update = () => {
      const left = scroller.scrollWidth - scroller.clientWidth - scroller.scrollLeft;
      frame.classList.toggle('has-more', left > 2);
    };

    scroller.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(scroller);
    update();
  }
</script>

<style>
  .fig {
    margin: 30px 0;
  }

  .fig__label {
    margin: 0 0 8px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .fig__frame {
    position: relative;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  /* Отступы переезжают внутрь, чтобы растушёвка осталась на месте при прокрутке */
  .fig__frame--scroll {
    padding: 0;
  }

  .fig__scroller {
    padding: 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .fig__frame--scroll::after {
    content: "";
    position: absolute;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: 52px;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: linear-gradient(to right, transparent, var(--surface) 86%);
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .fig__frame--scroll.has-more::after {
    opacity: 1;
  }

  .fig__cap {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--faint);
  }

  .fig__cap :global(strong) {
    color: var(--muted);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .fig__frame {
      padding: 16px 14px;
    }

    .fig__frame--scroll {
      padding: 0;
    }

    .fig__scroller {
      padding: 16px 14px;
    }
  }
</style>
