---
/**
 * Наконечники стрелок для блок-схем — один раз на страницу.
 *
 * marker в SVG адресуется по id на уровне документа, поэтому достаточно
 * вывести этот невидимый svg где угодно выше по разметке, а все остальные
 * схемы ссылаются на url(#flow-arrow*). Цвет не наследуется от линии, так
 * что на каждый цвет ребра — свой marker (context-stroke поддержан не
 * везде, а промахнуться тут — значит получить чёрные стрелки в тёмной теме).
 */
---

<svg class="flow-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0.8 L9.5 5 L0 9.2 z" fill="var(--faint)" />
    </marker>
    <marker id="flow-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0.8 L9.5 5 L0 9.2 z" fill="var(--ok)" />
    </marker>
    <marker id="flow-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0.8 L9.5 5 L0 9.2 z" fill="var(--accent)" />
    </marker>
  </defs>
</svg>

<style>
  .flow-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
