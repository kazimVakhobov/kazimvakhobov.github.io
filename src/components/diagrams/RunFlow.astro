---
/**
 * Схема 5. Один запуск задачи и четыре момента, в которых detent сам
 * работает с сабмодулями — они пронумерованы кружками. Между ними он их
 * не трогает, и это весь контракт.
 */
import './flow.css';
---

<svg class="flow" viewBox="0 0 700 496" role="img" aria-label="During a task run detent refreshes the shared context, checks the task's links, verifies the submodule pointer before the commit, and puts the pointer back if the run ends without one.">
  <!-- ряд 1: от файла задачи до хода агента -->
  <rect class="flow-box" x="12" y="44" width="140" height="64" rx="7" />
  <text class="flow-title flow-title--sans" x="26" y="70">the task starts</text>
  <text class="flow-mono" x="26" y="90">tasks/todo/0042.md</text>

  <path class="flow-edge" d="M152 76 H168" />

  <rect class="flow-box" x="174" y="44" width="190" height="64" rx="7" />
  <text class="flow-title flow-title--sans" x="188" y="70">the context is refreshed</text>
  <text class="flow-mono" x="188" y="90">submodule update --remote</text>

  <path class="flow-edge" d="M364 76 H380" />

  <rect class="flow-box" x="386" y="44" width="150" height="64" rx="7" />
  <text class="flow-title flow-title--sans" x="400" y="70">links checked</text>
  <text class="flow-sub" x="400" y="90">against that revision</text>

  <path class="flow-edge" d="M536 76 H552" />

  <rect class="flow-box" x="558" y="44" width="130" height="64" rx="7" />
  <text class="flow-title flow-title--sans" x="572" y="70">the agent's turn</text>
  <text class="flow-sub" x="572" y="90">reads, then writes</text>

  <!-- ряд 2: проверка указателя перед коммитом -->
  <path class="flow-edge" d="M623 108 V218 H546" />
  <text class="flow-label" x="613" y="160" text-anchor="end">the work is done</text>

  <rect class="flow-box" x="300" y="186" width="240" height="64" rx="7" />
  <text class="flow-title flow-title--sans" x="314" y="212">the pointer is verified</text>
  <text class="flow-mono" x="314" y="232">branch -r --contains HEAD</text>

  <!-- ряд 3: два исхода -->
  <path class="flow-edge flow-edge--ok" d="M480 250 V292 H560 V320" />
  <text class="flow-label flow-ok" x="625" y="286" text-anchor="middle">on a remote branch</text>

  <path class="flow-edge flow-edge--accent" d="M360 250 V292 H170 V320" />
  <text class="flow-label flow-accent" x="115" y="286" text-anchor="middle">on none</text>

  <rect class="flow-box flow-box--ok" x="380" y="326" width="300" height="64" rx="7" />
  <text class="flow-title flow-title--sans flow-ok" x="394" y="352">committed with the task</text>
  <text class="flow-sub" x="394" y="372">the code, and the revision it read</text>

  <rect class="flow-box flow-box--accent" x="20" y="326" width="300" height="64" rx="7" />
  <text class="flow-title flow-title--sans flow-accent" x="34" y="352">the task pauses</text>
  <text class="flow-sub" x="34" y="372">and names the submodule</text>

  <!-- ряд 4: откат указателя -->
  <path class="flow-edge" d="M170 390 V422" />
  <text class="flow-label" x="182" y="410">nothing was committed</text>

  <rect class="flow-box" x="20" y="428" width="300" height="54" rx="7" />
  <text class="flow-title flow-title--sans" x="34" y="452">the pointer is put back</text>
  <text class="flow-sub" x="34" y="470">no dirty tree left behind</text>

  <!-- четыре момента, которые принадлежат detent -->
  {
    [
      { n: 1, x: 174, y: 44 },
      { n: 2, x: 386, y: 44 },
      { n: 3, x: 300, y: 186 },
      { n: 4, x: 20, y: 428 },
    ].map((b) => (
      <>
        <circle cx={b.x} cy={b.y + 16} r="9.5" fill="var(--accent)" />
        <text class="flow-mono" x={b.x} y={b.y + 20} text-anchor="middle" fill="var(--bg)">
          {b.n}
        </text>
      </>
    ))
  }
</svg>

<ul class="flow-legend">
  <li><i class="is-ok"></i>lets the commit through</li>
  <li><i class="is-accent"></i>stops and asks a person</li>
  <li><i></i>the run's own steps</li>
</ul>
