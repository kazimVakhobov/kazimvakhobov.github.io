---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
// Кадрирование живёт в самом файле, а не в CSS-трансформе: иначе Astro
// собирает превью со всего снимка и в 128px лицо получается из полусотни
// пикселей. Снимок обрезан до 510×510 — голова, плечи и скрещённые руки.
import avatar from '../assets/avatar.jpeg';
import site from '../data/site.json';

// Шаблонные элементы с пустым текстом не показываем — заполнятся из словаря позже.
const facts = site.sidebar.facts.filter((f) => f.label.trim() !== '');
const socials = site.sidebar.socials.filter((s) => s.href.trim() !== '');
const hasCv = site.sidebar.cvHref.trim() !== '';
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar__top">
    <a class="avatar" href="/" aria-label={site.nav.home}>
      <Image src={avatar} alt={site.sidebar.avatarAlt} widths={[128, 256]} sizes="128px" loading="eager" />
    </a>

    <p class="sidebar__name">{site.sidebar.name}</p>
    <p class="sidebar__role">{site.sidebar.role}</p>
    {site.sidebar.bio && <p class="sidebar__bio">{site.sidebar.bio}</p>}

    {
      facts.length > 0 && (
        <ul class="facts">
          {facts.map((fact) => (
            <li>
              <Icon name={fact.icon} />
              {fact.href ? <a href={fact.href}>{fact.label}</a> : <span>{fact.label}</span>}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="sidebar__bottom">
    {
      socials.length > 0 && (
        <ul class="socials">
          {socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener" target="_blank" aria-label={social.label}>
                <Icon name={social.icon} />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      hasCv && (
        <a class="btn btn--primary" href={site.sidebar.cvHref} download>
          <Icon name="download" />
          <span>{site.sidebar.cv}</span>
        </a>
      )
    }
  </div>
</aside>
