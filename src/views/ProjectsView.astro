---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { getProjects, allTags } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const tags = allTags(projects);
---

<BaseLayout
  lang={lang}
  path="/projects/"
  title={t.projects.metaTitle}
  description={t.projects.metaDescription}
>
  <nav class="crumbs" aria-label={t.projects.heading}>
    <a href={localizePath('/', lang)}>{t.nav.home}</a>
    <span aria-hidden="true">/</span>
    <span>{t.projects.heading}</span>
  </nav>

  <section class="section section--first">
    <h1 class="section__title">{t.projects.heading}</h1>
    {t.projects.lead && <p class="section__lead">{t.projects.lead}</p>}

    {
      tags.length > 1 && (
        <div class="chips" id="project-filter" style="margin-bottom:22px">
          <button class="chip chip--button" type="button" data-tag="*" aria-pressed="true">
            {t.projects.filterAll}
          </button>
          {tags.map((tag) => (
            <button class="chip chip--button" type="button" data-tag={tag} aria-pressed="false">
              {tag}
            </button>
          ))}
        </div>
      )
    }

    {
      projects.length > 0 ? (
        <ul class="cards" id="project-list">
          {projects.map((project) => (
            <ProjectCard project={project} lang={lang} t={t} />
          ))}
        </ul>
      ) : (
        <p class="prose">{t.projects.empty}</p>
      )
    }
  </section>
</BaseLayout>

<script>
  // Фильтр по тегам: без запросов, просто скрываем карточки.
  const filter = document.getElementById('project-filter');
  const list = document.getElementById('project-list');

  filter?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag]');
    if (!btn || !list) return;

    const tag = btn.dataset.tag!;
    filter.querySelectorAll<HTMLButtonElement>('button[data-tag]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b === btn));
    });

    list.querySelectorAll<HTMLLIElement>('li.card').forEach((card) => {
      const tags = (card.dataset.tags ?? '').split('|');
      card.hidden = tag !== '*' && !tags.includes(tag);
    });
  });
</script>
